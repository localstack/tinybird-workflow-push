{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "isolatedModules": true,
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "ignoreDeprecations": "6.0"
  },
  "include": ["./__tests__/**/*", "./__mocks__/**/*", "./src/**/*"]
}
